 "poems": [
  {
   "seq": "1",
   "text": "遣ふしこそ嵐にさやく篠のはの深山の霞む春はきにけり",
   "kana": "",
   "speaker": "慶運",
   "page": 1,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "立春",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "いつのまに松吹しまの風はやみ見ほの浦事はかすみこむらん",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浦霞",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "あま衣春くる空の朝なきに袖しの浦はかすみこめつゝ",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浦霞",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "うくゐ頃のをのか羽風も吹とちていかにこはれる涙なるらむ",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鶯",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "朝みとり野への霞を白妙の袖にかさねてわかなつむなり",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "若菜",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "雲こほる空にはしはしきえやらて風のうへなか夫のあは雪",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春雪",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "あさはてし難波の里の春風に今はたおなし梅かこそする",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "里梅",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "さほ姫の霞の衣うちなひき袖にすりとる青やきのいと",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "柳",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "はつ草のはつかにもゆる煙たになをうつれく野への早蕨",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早蕨",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "袖ぬらすふしのすそのゝ春雨やよそに見へつる雪を成らん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "採春雨",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "つなかれぬ天の心とさくらあさのおふの下草駒いはふなり",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春約",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "一たかかたに行ともしらすよし野ゝ田西のかりの春のわかれは",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "帰雁",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "詠やる遠山姫の花かつらかせてまたれぬ時のまもなし",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "まかはすは花とも見へし都より雲の八重たつ峯の木すへは",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "木の毛とにきてたに雲とまかひけるおにをさくらとよそに見つらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "花の色にまかひし雲はかたみにてのち忍ふへきそらめ成けり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "花さそふかたのゝみのゝ春風に雲のとをなるあまのはしなみ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "我身よに猶すてやうてすみれ草心はそめし色ふかくとも",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "華",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "手〳〵にありて別し名残たにかこ地そへつる老の春かな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮春",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "立かふ類衣ならねとこの称ぬあさのた毛とに夏はきにけり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "朝更衣",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "夏山の風こそ匂へせみのみのみのうす花さくらはふやさくらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "余花",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "袖ぬらす我身のためや山里のよをうの花毛皮と見ゆらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "卯花",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "時尊きはすは何を外山なるまさきのかつらくるかひにせん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "尋郭公",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "やとかれと花たち花はにほへとも心もとめぬ時鳥かな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "尋郭公",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "しるやいかに山時鳥とき過てかれ行ころの通ぬ思かは",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "尋郭公",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "に山田にとるやさなへの今日よりも稲葉の雲の秋そまたるゝ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早苗",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "一壱羽山雲の浪さへわきかへる瀧のしらあは五月雨のころ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "水のあはのあさになかるゝをおしせにきへぬよかはのかゝり火の影",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鵜川かは七",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "かひなしやいくよもへてもさをしかにあはぬほくしのむなしけふりは",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "照射",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "いつしかとおきうからても見ゆる哉さくやあしたの床夏のはな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "瞿夏",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "かくはかり磯かふせやのいやしきもさかりは見ゆる夕魚の花",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕顔",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "塩風のふきこす音もたかし山のうみくらき夕立のそら",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海夕立",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "みかりのに見へし氷室やあつさらすへもたへせぬみつさ出るらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "氷室",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "御祓すとゆふかけてけりさはた河袖つら水のあさのたちえに",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏抜",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "いたつらに吹と思ひしあすか風輝くるけふのしるし成けり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "立秋",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "時わかぬみ山のいほりさひしさもいとゝましはの秋の初風",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家初秋",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "天河水のこゝろやわくらはにしつめかねてやあふせ侍らん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七夕",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "軒端なるいさゝむら竹それならてそよくか夜はの萩の上風",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "故郷の庭のはき糸しけゝれと草にやつれぬ花さかり哉",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "花すゝき草のたもとの露散て手玉毛遊らふ秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "薄",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "朝なく咲か苔地の花よりもさかりは見ゆる庭のあさかは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "桜",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "有明の光を見てもなく鹿は山よりいてぬつまや待らん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鹿",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "いかなれは涙をからぬむしのねもさのみ枕の下になくらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "虫",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "すみのほるほとをはまたし奥山のまきの葉しのき出月影",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "みれはなと心すむらん村雲のひまゆく月はのちけからぬを",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "かくはかり晴なき霧のへたてともしらてや月の空にはむらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "世のうさを模かねし身や山里の月にもあかぬ心なるらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "わたの原風そ夏よりと思ひしを夜舟は月のさそふ成けり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "あしからの山立かくす霧の上にひとりはれたるふしの芝山",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霧",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "色かはるまさきのかつらなかき夜に外山の里は衣うつらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "擣衣",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "をしなへてまた色うすき紅葉哉いつれ根の梢なまらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "紅葉はも千入まてこそこそこそこそこかきりの老の涙そ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "うつろいてち類かとそ見る浜風の吹上にたてる白菊の花",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "菊",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "おしからぬ露の命をのこし置てまたあたものと秋そくれ行",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮秋",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "格散いはたをのゝあさあらしに山路しくれて冬はきにけり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初冬",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "夜な〳〵の月も類雨にも袖ぬれし寝やの板まにふる時雨哉",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "時雨",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "たえ〳〵に音そきこゆる花くもりふらぬ木のはの時雨おれとも",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "春日のゝ雪まきたにも萌出し草柴そ霜にあへすかれぬる",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒草",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "霜かれに残るともなき難波江のあしねやさのしるし成らん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "江寒芦",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "夜を寒みにほて類浦は楽浪のなきのみたてるゑほる比哉も",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湖氷",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "道を思ひ身をなけくとてさよ千鳥和歌の浦半に出りぬ日そなし",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "千鳥",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "いつまてとつらきぬ鳥のなからへむことは矢野に草かくるらん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鷹狩",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "さえまさる夜半とやわきて思ふらんともねのをしめさとは風を",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水鳥",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "山風にさやく常磐木のかけのゝに筆霰布るなり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "篠霰",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "雲たにもたなひきかくす紫の戸は埋もれやすき雪の中哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雪",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "草も木も埋もれはつる雪にこそなか〳〵山はあらは成けり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雪",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "たゝちめのあつめし雪はそれなからあそゝしもなき身もふりにけり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雪",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "大原や小野の炭電いとまなみもへつゝとちに立けふり哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "炭竈",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "かきりなく老ぬる後のひとゝ世は身にくもるもよしや歎かし",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳暮",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "身にあまる思ひのほともしらるへき涙を人になにつゝむらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恋忍恋",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "そふといへは親のまもるにはつる哉我人しれぬあふ坂の関",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忍親昨恋",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "よひ〳〵に見しはあたなる夢そともいつのうつ々に思ひはせん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄夢恋",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "恋しなん命のなかをかきりにて後の世まては歎か次もかな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不逢恋",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "なからへてたのむもくもしほし世のちきりありその浦のあらなは",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不逢恋",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "尋ぬへき美かあたりそたとらるゝわかやとるへく侍しならひは",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "疑住所恋",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "夢にたもあひみぬ中を後のやみのうつゝにまたやしたはん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "切応",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "みかりのにかくろひかねて立とりものあはて命をすつる物かは",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄鳥恋",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "るくはかりまたるゝ暮をいつはりになれて頼まん身とや知らん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "待恋",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "こぬ人をまつとしらてやこもるらん真木の板戸のいさよひの月",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄月待恋",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "うつゝともわかぬ契りはよひ〳〵にみしを夢そと知程もなし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "過応",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "関守のゆるさぬ道をたとりきてぬるよそまよふあふ坂の山",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "尋進恋",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "さゝ枕たゝかりそめと思ふなよ一夜のふしも代々の契を",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅宿逢恋",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "別路をこと葉のこらすしたいとやかねては鳥のおとろかすらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "別恋",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "人しれぬわかねきことを頼む哉いさやよる也の水のこゝろは",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "新恋",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "称しあれは梢に称さす屋とり木のかりそめなからかれぬならかな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "未紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "たち別いくたひ袖にかゝるらんたへぬと見へしさゝかにの糸",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "稀恋",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "人しれぬ花かゝもとはなか〳〵にかれにし後そあらは成ける",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "絶後顕応",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "もしほ火の畑にくわる月も見つかひなき里のしるへとふとて",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "悪恋",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "ことの薬をつくして後は立かへり身をしるかひもおきうらみ哉",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "悪恋",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "杣川や高瀬さしこすかたしのたゝむかうへにたゝぬしら波",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑杣川筏",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "をくれゐて道まよへとは和哥浦による鳴鶴や思はさるらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "名所鶴",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "たつ手きて住いゐかなる宿とたに人にしられぬ山の奥哉",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "小鹿伏苅田の霜の寒り夜そ庵云夜そ庵えるよりいねかてにする",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田家",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "うきてふる我身をさそふ松浦船まつらんと思ふかたならねとも",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄舟雑",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "都出し日数かさねてあつまなる霞の関も秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "羇旅送日",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "さのみかくみしいにしへの恋しきはいつより後のうき世成らん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "懐旧",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "さすかまた歎くもやすきこの世哉捨ての後のかすならぬ身は",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "述懐",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "跡たれしそのかたそきの宮はしろ立かゆるへき御代や侍らん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "神祇",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "伏て思ひて思ひけるも君か代をよるひる守る神そしからん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "神祇",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "あまつ空霞のうへは出る日の飛かりも両よし春や立らん",
   "kana": "",
   "speaker": "権大僧都尭孝一",
   "page": 11,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "延徳三年九月十五日立春"
  },
  {
   "seq": "101",
   "text": "和たの原行来もはたもしら波のたつをかき祭に霞春とな",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霞",
   "kotobagaki": ""
  },
  {
   "seq": "102",
   "text": "これや此おさまれる世の声ならし見かきの竹に暮のかく",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鶯",
   "kotobagaki": ""
  },
  {
   "seq": "103",
   "text": "朝ほらけ山のいつこはみえわかて霞のひまに雪そ残れる",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734031",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残雪",
   "kotobagaki": ""
  }
 ],
 "catalog": {
